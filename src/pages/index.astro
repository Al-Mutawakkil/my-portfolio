---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Work from '../components/Work.astro';
import HowItWorks from '../components/HowItWorks.tsx';
import About from '../components/About.astro';
import Testimonials from '../components/Testimonials.astro';
import CTA from '../components/CTA.astro';
import GeoFAQ from '../components/GeoFAQ.astro';
import BlogTeaser from '../components/BlogTeaser.astro';
import Footer from '../components/Footer.astro';

const projectStructuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: 'Karmaclub',
    creator: { '@id': '/#person' },
    description: 'Admin dashboard, entrepreneur portal, and investor-facing funding flows for a project investment platform.',
    keywords: 'dashboard, investment platform, admin workflows, funding pipeline',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'YOLO Padel',
    creator: { '@id': '/#person' },
    applicationCategory: 'BusinessApplication',
    description: 'Multi-venue padel court booking platform with online payments, dynamic pricing, RBAC, and an admin dashboard.',
    keywords: 'booking platform, payments, dashboard, court management',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'AYANA Rewards',
    creator: { '@id': '/#person' },
    applicationCategory: 'MobileApplication',
    description: 'Offline-first mobile loyalty app for hotel staff with AI-powered receipt OCR and background sync.',
    keywords: 'mobile app, loyalty app, OCR, offline-first, background sync',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Swasana Wedding',
    creator: { '@id': '/#person' },
    applicationCategory: 'BusinessApplication',
    description: 'Wedding venue booking management with an end-to-end leads pipeline for the sales team.',
    keywords: 'booking management, sales pipeline, venue management, web app',
  },
];

const faqStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What does Thufail Adib Al Mutawakkil build?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Thufail Adib Al Mutawakkil builds websites, web apps, dashboards, internal tools, and mobile apps for startups and small businesses.',
      },
    },
    {
      '@type': 'Question',
      name: 'Who does Adib usually work with?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Adib usually works with founders, lean teams, startups, small businesses, and teams that need practical software shipped quickly.',
      },
    },
    {
      '@type': 'Question',
      name: 'What kind of web apps can Adib build?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Adib can build booking platforms, dashboards, admin panels, payment flows, internal tools, portals, and product MVPs.',
      },
    },
    {
      '@type': 'Question',
      name: 'What technologies does Adib use?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Adib works with tools such as Next.js, React, TypeScript, Flutter, PostgreSQL, Prisma, and AI APIs depending on the project needs.',
      },
    },
    {
      '@type': 'Question',
      name: 'How can someone hire Adib?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'You can email Adib or book a call to discuss the project scope, timeline, technical needs, and whether the fit is right before the build starts.',
      },
    },
  ],
};
---

<Layout structuredData={[...projectStructuredData, faqStructuredData]}>
  <!-- Floating shapes -->
  <div class="shapes-layer">
    <div class="shape shape-1"></div>
    <div class="shape shape-2"></div>
    <div class="shape shape-3"></div>
  </div>

  <Nav />
  <Hero />
  <Work />
  <HowItWorks />
  <About />
  <GeoFAQ />
  <CTA />
  <BlogTeaser />
  <Footer />
</Layout>

<script>
  // Scroll reveal with stagger
  const reveals = document.querySelectorAll('.reveal');
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
        observer.unobserve(entry.target);
      }
    });
  }, {
    threshold: 0.12,
    rootMargin: '0px 0px -40px 0px'
  });
  reveals.forEach(el => observer.observe(el));

  // FAQ accordion
  document.querySelectorAll('.faq-question').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.parentElement;
      if (!item) return;
      const wasOpen = item.classList.contains('open');
      document.querySelectorAll('.faq-item').forEach(i => i.classList.remove('open'));
      if (!wasOpen) item.classList.add('open');
    });
  });

  // Scroll-locked stats reveal
  (() => {
    const wrapper = document.querySelector('.stats-scroll-wrapper');
    const label = document.querySelector<HTMLElement>('.stats-label');
    const statItems = document.querySelectorAll<HTMLElement>('.stat-item');
    if (!wrapper || !statItems.length) return;

    let ticking = false;
    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          const rect = wrapper.getBoundingClientRect();
          const wrapperHeight = (wrapper as HTMLElement).offsetHeight;
          const viewH = window.innerHeight;

          const scrollIntoWrapper = -rect.top;
          const maxScroll = wrapperHeight - viewH;
          const progress = Math.max(0, Math.min(1, scrollIntoWrapper / maxScroll));

          if (label) {
            if (progress >= 0.05) {
              label.style.opacity = '1';
              label.style.transform = 'translateY(0)';
            } else {
              label.style.opacity = '0';
              label.style.transform = 'translateY(20px)';
            }
            label.style.transition = 'opacity 0.5s, transform 0.5s var(--smooth)';
          }

          statItems.forEach((item, i) => {
            const phaseStart = 0.15 + (i * 0.25);
            if (progress >= phaseStart) {
              item.classList.add('stat-visible');
            } else {
              item.classList.remove('stat-visible');
            }
          });

          ticking = false;
        });
        ticking = true;
      }
    });
  })();

  // Smooth scroll for anchor links
  document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', (e) => {
      e.preventDefault();
      const href = (e.currentTarget as HTMLAnchorElement).getAttribute('href');
      if (!href) return;
      if (href === '#' || href === '#top') {
        window.scrollTo({ top: 0, behavior: 'smooth' });
        return;
      }
      const target = document.querySelector(href);
      if (target) {
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  });
</script>
