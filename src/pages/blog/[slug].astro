---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { getCollection, getEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.slug } }));
}

const { slug } = Astro.params;
const post = await getEntry('blog', slug!);
if (!post) return Astro.redirect('/blog');

const { Content } = await post.render();
const { title, description, date, tags, cover, readTime, mediumUrl } = post.data;

const formattedDate = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
}).format(date);

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? new URL(Astro.url.origin));
const imageURL = new URL(cover, Astro.site ?? new URL(Astro.url.origin));
const blogStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  image: String(imageURL),
  datePublished: date.toISOString(),
  dateModified: date.toISOString(),
  author: { '@id': String(new URL('/#person', Astro.site ?? new URL(Astro.url.origin))) },
  publisher: { '@id': String(new URL('/#person', Astro.site ?? new URL(Astro.url.origin))) },
  mainEntityOfPage: String(canonicalURL),
  url: String(canonicalURL),
  keywords: tags.join(', '),
  inLanguage: 'en',
};
---

<Layout title={`${title} | Thufail Adib Al Mutawakkil`} description={description} image={cover} structuredData={blogStructuredData}>
  <Nav />
  <main class="post-page">
    <div class="post-container">
      <a href="/blog" class="back-link">← All posts</a>

      <img class="post-cover" src={cover} alt={title} loading="lazy" />

      <div class="post-header">
        <div class="post-tags">
          {tags.map((tag) => <span class="post-tag">{tag}</span>)}
        </div>
        <h1 class="post-title">{title}</h1>
        <div class="post-meta">
          <span>{formattedDate}</span>
          <span class="post-meta-sep">·</span>
          <span>{readTime} min read</span>
        </div>
      </div>

      <div class="post-body">
        <Content />
      </div>

      <section class="author-card" aria-label="About the author">
        <div>
          <span class="author-kicker">Written by</span>
          <h2>Thufail Adib Al Mutawakkil</h2>
          <p>
            Adib is a freelance full-stack developer from Indonesia who builds websites, web apps, dashboards, internal tools, and mobile apps for startups and small businesses.
          </p>
        </div>
        <a href="mailto:thufails505@gmail.com" class="author-link">Work with Adib →</a>
      </section>

      <div class="post-footer">
        <span class="post-thanks">Thanks for reading ✦</span>
        {mediumUrl && (
          <a href={mediumUrl} target="_blank" rel="noopener noreferrer" class="medium-link">
            Also on Medium →
          </a>
        )}
      </div>
    </div>
  </main>
  <Footer />
</Layout>
